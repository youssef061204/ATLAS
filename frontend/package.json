{
  "name": "atlas-interface",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-demo.mjs && next dev",
    "build": "node scripts/prepare-demo.mjs && next build",
    "start": "next start",
    "lint": "eslint app components lib next.config.ts --max-warnings=0",
